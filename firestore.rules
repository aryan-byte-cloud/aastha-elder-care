rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function currentUserData() {
      return getUserDoc(request.auth.uid);
    }

    function currentUserRole() {
      return currentUserData().role;
    }

    function currentUserOrgId() {
      return currentUserData().orgId;
    }

    function isPlatformAdmin() {
      return hasUserDoc() && currentUserRole() == 'platform_admin';
    }

    function isUserOrgAdminRole(orgId) {
      return hasUserDoc() && currentUserRole() == 'admin' && currentUserOrgId() == orgId;
    }

    function isOrgAdmin(orgId) {
      return isUserOrgAdminRole(orgId) &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'approved';
    }

    function isVerifiedVolunteer(orgId) {
      return hasUserDoc() &&
        currentUserRole() == 'volunteer' &&
        currentUserOrgId() == orgId &&
        currentUserData().verified == true &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'approved';
    }

    function isLinkedFamily(residentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/residents/$(residentId)) &&
        request.auth.uid in get(/databases/$(database)/documents/residents/$(residentId)).data.familyUserIds;
    }

    function isTimelineAppended() {
      return ('timeline' in request.resource.data) &&
        (
          ('timeline' in resource.data) ?
            (
              request.resource.data.timeline.size() == resource.data.timeline.size() + 1 &&
              request.resource.data.timeline.hasAll(resource.data.timeline)
            ) :
            (request.resource.data.timeline.size() == 1)
        );
    }

    function isVolunteerAlertAccept() {
      return resource.data.status == 'open' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'timeline']) &&
        request.resource.data.acceptedBy.uid == request.auth.uid &&
        isTimelineAppended();
    }

    function isVolunteerAlertArrived() {
      return resource.data.status == 'accepted' &&
        request.resource.data.status == 'arrived' &&
        resource.data.acceptedBy.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timeline']) &&
        isTimelineAppended();
    }

    function isVolunteerAlertResolved() {
      return resource.data.status == 'arrived' &&
        request.resource.data.status == 'resolved' &&
        resource.data.acceptedBy.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timeline']) &&
        isTimelineAppended();
    }

    function isVolunteerAlertDeclined() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declinedBy']) &&
        (
          (!('declinedBy' in resource.data) || resource.data.declinedBy == null || resource.data.declinedBy.size() == 0) ?
            (request.resource.data.declinedBy == [request.auth.uid]) :
            (
              request.resource.data.declinedBy.hasAll(resource.data.declinedBy) &&
              request.resource.data.declinedBy.size() == resource.data.declinedBy.size() + 1 &&
              (request.auth.uid in request.resource.data.declinedBy)
            )
        );
    }

    function isVolunteerAlertEscalate() {
      return resource.data.status == 'open' &&
        request.time > resource.data.createdAt + duration.value(60, 's') &&
        request.resource.data.status == 'escalated' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timeline']) &&
        isTimelineAppended();
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Read own doc; org admins read users of their org; platform_admin reads all
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isPlatformAdmin() ||
        ('orgId' in resource.data && resource.data.orgId != null && isOrgAdmin(resource.data.orgId))
      );

      // Create own doc only with role "family" or "volunteer" (volunteer with verified false),
      // OR role "admin" only when created in the same batch as a new organizations doc with status "pending" and submittedBy == uid
      allow create: if isSignedIn() && request.auth.uid == userId && (
        (
          request.resource.data.role == 'family' &&
          (!('orgId' in request.resource.data) || request.resource.data.orgId == null)
        ) ||
        (
          request.resource.data.role == 'volunteer' &&
          request.resource.data.verified == false &&
          (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'pending')
        ) ||
        (
          request.resource.data.role == 'admin' &&
          getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.status == 'pending' &&
          getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.submittedBy == request.auth.uid
        )
      );

      // Org admins may update verified and verificationStatus of volunteers in their org.
      // platform_admin may update anything.
      // Users can update their own profile (e.g. name, phone) but can NEVER change their own role, orgId, verified or verificationStatus.
      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (
          'orgId' in resource.data && resource.data.orgId != null &&
          isOrgAdmin(resource.data.orgId) &&
          resource.data.role == 'volunteer' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verificationStatus'])
        ) ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'orgId', 'verified', 'verificationStatus'])
        )
      );

      allow delete: if isPlatformAdmin();
    }

    // ==========================================
    // 2. ORGANIZATIONS COLLECTION
    // ==========================================
    match /organizations/{orgId} {
      // Public read only if status == "approved"; the submitter and platform_admin can read their pending/rejected org.
      // Also org admin can read their own org (even while pending).
      allow read: if (resource.data.status == 'approved') ||
        (isSignedIn() && (
          isPlatformAdmin() ||
          resource.data.submittedBy == request.auth.uid ||
          isUserOrgAdminRole(orgId)
        ));

      // Create only with status "pending" and submittedBy == uid
      allow create: if isSignedIn() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.submittedBy == request.auth.uid;

      // Only platform_admin can change status/reviewedBy/reviewedAt.
      // The org's admin may update only phone (even while pending).
      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (
          isUserOrgAdminRole(orgId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone'])
        )
      );

      allow delete: if isPlatformAdmin();
    }

    // ==========================================
    // 3. ORG DOCUMENTS COLLECTION
    // ==========================================
    match /orgDocuments/{docId} {
      // Create by the org submitter (supports batch create or post-create)
      allow create: if isSignedIn() && (
        (
          existsAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)) &&
          getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.submittedBy == request.auth.uid
        ) ||
        (
          exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)) &&
          get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.submittedBy == request.auth.uid
        )
      );

      // Read only by platform_admin and that org's admins (even while pending)
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        isUserOrgAdminRole(resource.data.orgId)
      );

      // No updates
      allow update: if false;

      allow delete: if isPlatformAdmin();
    }

    // ==========================================
    // 4. RESIDENTS COLLECTION
    // ==========================================
    match /residents/{residentId} {
      // Read by org admins, by family whose uid is in familyUserIds, and by verified volunteers of the org
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        isOrgAdmin(resource.data.orgId) ||
        (request.auth.uid in resource.data.familyUserIds) ||
        isVerifiedVolunteer(resource.data.orgId)
      );

      // Write only by org admins
      allow create: if isSignedIn() && isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);
    }

    // ==========================================
    // 5. MEDICINES, DOSE LOGS, HEALTH UPDATES
    // ==========================================
    match /medicines/{medicineId} {
      // Read by org admins and by family linked to that resident; write by org admins
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        isOrgAdmin(resource.data.orgId) ||
        isLinkedFamily(resource.data.residentId)
      );
      allow create: if isSignedIn() && isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);
    }

    match /doseLogs/{logId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        isOrgAdmin(resource.data.orgId) ||
        isLinkedFamily(resource.data.residentId)
      );
      allow create: if isSignedIn() && isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);
    }

    match /healthUpdates/{updateId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        isOrgAdmin(resource.data.orgId) ||
        isLinkedFamily(resource.data.residentId)
      );
      allow create: if isSignedIn() && isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);
    }

    // ==========================================
    // 6. ALERTS COLLECTION
    // ==========================================
    match /alerts/{alertId} {
      // Read by org admins, verified volunteers of the org, and family linked to the resident
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        isOrgAdmin(resource.data.orgId) ||
        isVerifiedVolunteer(resource.data.orgId) ||
        isLinkedFamily(resource.data.residentId)
      );

      // Create by org admins
      allow create: if isSignedIn() && isOrgAdmin(request.resource.data.orgId);

      // Update by org admins (full access), OR verified volunteers (strictly validated state transitions)
      allow update: if isSignedIn() && (
        isOrgAdmin(resource.data.orgId) ||
        (
          isVerifiedVolunteer(resource.data.orgId) &&
          (
            isVolunteerAlertAccept() ||
            isVolunteerAlertArrived() ||
            isVolunteerAlertResolved() ||
            isVolunteerAlertDeclined() ||
            isVolunteerAlertEscalate()
          )
        )
      );

      allow delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);
    }

    // ==========================================
    // 7. FAMILY REQUESTS COLLECTION
    // ==========================================
    match /familyRequests/{requestId} {
      // Create only for yourself with status "pending"
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Read your own; org admins read requests of their org
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isOrgAdmin(resource.data.orgId) ||
        isPlatformAdmin()
      );

      // Org admins update requests of their org (approve/reject)
      allow update: if isSignedIn() && isOrgAdmin(resource.data.orgId);

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isOrgAdmin(resource.data.orgId)
      );
    }

    // ==========================================
    // 8. INVITE CODES COLLECTION
    // ==========================================
    match /inviteCodes/{code} {
      // Signed-in users may GET a single code document (no listing)
      allow get: if isSignedIn();
      allow list: if false;

      // Written by admins of that org
      allow create: if isSignedIn() && isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);
    }

    // ==========================================
    // DEFAULT: DENY EVERYTHING ELSE
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
